{
  "server": {
    "command": "npm run dev",
    "cwd": ".",
    "url": "http://127.0.0.1:5173",
    "readyPath": "/?og=1",
    "startupTimeoutMs": 180000
  },
  "route": "/?og=1",
  "selector": "#og-preview",
  "output": "storm/demo/public/storm.png",
  "width": 1200,
  "height": 630,
  "deviceScaleFactor": 1,
  "timeoutMs": 60000,
  "ready": {
    "type": "selector",
    "selector": ".storm-scope[data-playing=\"true\"][data-audio-ready=\"true\"]"
  },
  "actions": [
    {
      "type": "click",
      "selector": "button[aria-label=\"Play Storm\"]"
    }
  ],
  "browser": {
    "previewChannel": "chrome"
  }
}
